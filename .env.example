# --- Supabase (Session pooler, IPv4). La URL lleva ?sslmode=require y NO lleva user:pass embebido ---
SUPABASE_DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=

# --- Cognito (los mismos valores que usan los otros microservicios) ---
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=

# --- Credenciales temporales del Learner Lab (cambian en cada sesión) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Broker: sns (AWS) o rabbit (RabbitMQ / Amazon MQ). Es lo único que cambia para cambiar de broker ---
MESSAGING_PROVIDER=sns
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:<cuenta>:informe-topic
# Solo si MESSAGING_PROVIDER=rabbit:
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_SSL=false

# --- Seguridad entre componentes ---
# Mismo valor que en API Gateway (mapeo del header x-api-secret)
API_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
# true = el BFF rechaza cualquier /api/** (salvo /api/health) que no traiga x-api-secret (solo entra tráfico del Gateway)
BFF_ENFORCE_SECRET_ON_ALL=true
# Orígenes permitidos por CORS, separados por coma (agrega el dominio de Vercel)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://tu-app.vercel.app
